# Environment template for mono2 agent chat
# Copy to .env (backend) / frontend/.env.local as needed.

# --- Backend (Agno AgentOS + AG-UI) ---
OPENAI_API_KEY=
AGENT_OS_HOST=0.0.0.0
AGENT_OS_PORT=7777
AGENT_MODEL_ID=gpt-4o-mini
AGENT_NAME=chat-agent
AGENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (assistant-ui AG-UI client) ---
# Full agent endpoint including /agui (not just the host).
VITE_AGENT_URL=http://localhost:7777/agui
